# ==============================================================================
# KING SPORTS FRANCHISING — VARIÁVEIS DE AMBIENTE (.env.example)
# Copie este arquivo para .env e preencha com credenciais reais de produção.
# NUNCA versione o arquivo .env no Git.
# ==============================================================================

# --- Servidor HTTP & Gateway Unificado ---
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
TRUST_PROXY=1
PORTAL_API_HOST=127.0.0.1
PORTAL_API_PORT=4000
HUB_WEB_HOST=127.0.0.1
HUB_WEB_PORT=3333
PORTAL_API_INTERNAL_URL=http://127.0.0.1:4000
HUB_WEB_INTERNAL_URL=http://127.0.0.1:3333
NEXT_PUBLIC_PORTAL_API_BASE=/api/v1

# --- Arquitetura Multi-Domínio (3 Subdomínios em Produção + Fallback Localhost Dev/Test) ---
LP_HOST=lp.kinsports.com.br
LP_HOST_ALIASES=lp.kingsports.com.br,www.kingsports.com.br
CRM_HOST=crm.kingsports.com.br
HUB_HOST=app.kingsports.com.br
# Em produção, utilize URLs HTTPS dedicadas por subdomínio:
# LP_URL=https://lp.kinsports.com.br
# CRM_URL=https://crm.kingsports.com.br
# HUB_URL=https://app.kingsports.com.br
LP_URL=http://localhost:3000
CRM_URL=
HUB_URL=
CORS_ORIGIN=http://127.0.0.1:3000,http://localhost:3000,http://app.localhost:3000,http://hub.localhost:3000,http://crm.localhost:3000,http://lp.localhost:3000

# --- Segurança & Sessão ---
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=troque_por_chave_aleatoria_64_caracteres_hex
CSRF_SECRET=troque_por_chave_csrf_aleatoria_64_caracteres_hex
# Chave AES-256 (64 hex chars = 32 bytes) para criptografar segredos em system_settings
SETTINGS_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Em produção HTTPS, defina COOKIE_SECURE=true e mantenha COOKIE_DOMAIN vazio (cookies host-only por subdomínio)
COOKIE_SECURE=false
COOKIE_DOMAIN=

# --- Supabase (PostgreSQL + Auth) ---
# Jamais exponha SUPABASE_SERVICE_ROLE_KEY ao navegador!
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Opcional: Connection string PostgreSQL apenas para scripts/backup.sh (pg_dump)
# SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# --- Redis & Filas BullMQ ---
REDIS_URL=redis://127.0.0.1:6379
REDIS_PASSWORD=
BULLMQ_PREFIX=kingsports

# --- Tracking Client-Side (Público via /api/public/config) ---
GTM_CONTAINER_ID=
GA4_MEASUREMENT_ID=
GOOGLE_ADS_CONVERSION_ID=
GOOGLE_ADS_CONVERSION_LABEL_LEAD=
GOOGLE_ADS_CONVERSION_LABEL_QUALIFIED=
GOOGLE_ADS_CONVERSION_LABEL_SALE=
META_PIXEL_ID=

# --- Tracking Server-Side & APIs Oficiais (Somente Backend) ---
GA4_API_SECRET=
GA4_PROPERTY_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

META_CAPI_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_TEST_EVENT_CODE=

GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# --- Notificações & Webhooks Internos (Opcional) ---
ADMIN_NOTIFICATION_WEBHOOK_URL=
WHATSAPP_OFFICIAL_EXPANSION=5511999999999
EXPANSION_EMAIL=expansao@kingsportsoficial.com.br

# --- SLA & Automações ---
UNATTENDED_LEAD_SLA_MINUTES=30
WORKER_CONCURRENCY=5
