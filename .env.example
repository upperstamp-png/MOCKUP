# ====================================================================
# VARIÁVEIS DE AMBIENTE: .env.example
# Plataforma B2B de Mockups de Uniformes & Vestuário
# ====================================================================

# 1. AMBIENTE GERAL
NODE_ENV=production
PORT=4000
HOST=0.0.0.0
DOMAIN=app.suaconfeccao.com.br

# 2. SUPABASE (BANCO DE DADOS & STORAGE)
# URL do projeto Supabase (Local ou Cloud)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_URL=https://seu-projeto.supabase.co

# Chave pública para o Frontend (Anon Key - segura para o browser com RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJh...

# Chave privada com privilégios de Service Role (NUNCA expor no frontend)
SUPABASE_SERVICE_ROLE_KEY=eyJh...

# String de Conexão Direta PostgreSQL (para Migrations)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# 3. AUTENTICAÇÃO JWT
# Chave secreta de alta entropia para assinatura dos tokens JWT (mínimo 32 caracteres)
JWT_SECRET=super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_EXPIRES_IN=30d

# 4. CHAVE MESTRE DE ADMINISTRAÇÃO DA API
ADMIN_API_KEY=master-admin-key-change-in-prod

# 5. FRONTEND & CORS
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
CORS_ORIGIN=*

# 6. LIMITES DE UPLOAD
MAX_UPLOAD_SIZE=50MB
