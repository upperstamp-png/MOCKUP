[Unit]
Description=King Sports BullMQ Automation & CAPI Worker
After=network.target redis-server.service
Wants=redis-server.service

[Service]
Type=simple
User=kingsports
Group=kingsports
WorkingDirectory=/var/www/kingsports
Environment=NODE_ENV=production
Environment=SERVICE_NAME=king-worker
EnvironmentFile=/var/www/kingsports/.env
ExecStart=/usr/bin/node /var/www/kingsports/server/workers/worker.js
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=king-worker
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
