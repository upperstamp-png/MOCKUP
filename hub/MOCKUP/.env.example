# ==============================================================================
# KING SPORTS — PORTAL DO FRANQUEADO & MOCKUP STUDIO (.env.example)
# Copie para .env em hub/MOCKUP/.env e preencha credenciais reais.
# NUNCA versione .env nem exponha SUPABASE_SERVICE_ROLE_KEY no navegador.
# ==============================================================================

# --- Servidor Backend Node.js (Fastify) ---
NODE_ENV=development
PORT=4000
HOST=127.0.0.1
APP_URL=http://127.0.0.1:3333
CORS_ORIGIN=http://127.0.0.1:3333,http://localhost:3333
COOKIE_SECURE=false
COOKIE_SECRET=troque_por_chave_aleatoria_64_caracteres_hex
JWT_SECRET=troque_por_chave_jwt_aleatoria_64_caracteres_hex

# --- Supabase (PostgreSQL + Auth + Storage Privado) ---
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:[PASSWORD]@127.0.0.1:54322/postgres

# --- Redis (Rate Limit / Filas / Idempotência / Cache isolado por unidade) ---
REDIS_URL=redis://127.0.0.1:6379

# --- Segurança Administrativa de Serviço ---
ADMIN_API_KEY=troque_por_chave_admin_forte

# --- Integrações Externas (Deixar vazio quando ainda não homologadas/ativas) ---
ASAAS_API_KEY=
ASAAS_ENV=not_configured
NFE_EMITTER_API_KEY=
NFE_EMITTER_PROVIDER=not_configured
WHATSAPP_PROVIDER_TOKEN=
SMTP_URL=

# --- Frontend Next.js ---
PORTAL_API_INTERNAL_URL=http://127.0.0.1:4000
NEXT_PUBLIC_PORTAL_API_BASE=/api/v1
NEXT_PUBLIC_ENVIRONMENT_BADGE=
