{
  "name": "king-sports-franchising",
  "version": "1.0.0",
  "description": "Plataforma proprietária de aquisição, qualificação e conversão de franqueados King Sports — Landing Page HTML5, Blog SSR SEO, CRM Administrativo, Tracking Híbrido e Automações Node.js + BullMQ + Redis + Supabase.",
  "private": true,
  "type": "commonjs",
  "main": "server/app.js",
  "scripts": {
    "start": "node scripts/start-unified.js",
    "start:gateway": "node server/app.js",
    "start:api": "npm --prefix hub/MOCKUP run start --workspace=@mockup/api",
    "start:web": "npm --prefix hub/MOCKUP run start --workspace=@mockup/web",
    "dev": "node scripts/start-unified.js --dev",
    "build": "npm run lint:syntax && npm --prefix hub/MOCKUP run build",
    "worker": "node server/workers/worker.js",
    "scheduler": "node server/workers/scheduler.js",
    "test": "node --test tests/**/*.test.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "test:hub": "npm --prefix hub/MOCKUP test",
    "test:all": "npm test && npm --prefix hub/MOCKUP test",
    "seed:hub": "node hub/MOCKUP/node_modules/tsx/dist/cli.mjs hub/MOCKUP/scripts/seed-portal.ts",
    "lint:syntax": "node scripts/check-syntax.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "bullmq": "^5.40.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.5.0",
    "rate-limit-redis": "^4.2.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "supertest": "^7.0.0"
  }
}
